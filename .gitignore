# Dependencies
node_modules/

# Build output
dist/
.test-build/
*.tsbuildinfo

# Astro's generated types/content cache (docs site). `dist/` above already covers
# docs/dist, and `node_modules/` covers docs/node_modules — both patterns are unanchored.
.astro/

# Unit-test CI output (spec log + markdown step summary)
test-results/

# Logs
*.log
npm-debug.log*

# Local env / secrets (never commit API keys)
.env
.env.*

# OS
.DS_Store

# Claude Code personal settings (machine-specific)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Local run artifacts (screenshots, hierarchy dumps, temp files)
.verikun/
tmp/
.gstack/

# Written by .github/workflows/publish.yml at release time (the GitHub release body)
release-notes.md
