...@_style

direction: down

client: "Prepare test,\nthen reserve device"
host: Server computer {
  label.near: top-left
  supervisor: "Server checks devices\nand assigns tests" {
    style.stroke: "#c8401f"
    style.font-color: "#c8401f"
  }
  a: Device A {
    label.near: top-left
    executor: Device subprocess
    tools: adb / idb commands
  }
  b: Device B {
    label.near: top-left
    executor: Device subprocess
    tools: adb / idb commands
  }
}
phone_a: Phone A {style.stroke-dash: 5; style.fill: "#fbfaf6"}
phone_b: Phone B {style.stroke-dash: 5; style.fill: "#fbfaf6"}

client -> host.supervisor: reserve + keep alive
host.supervisor -> host.a.executor: send test step
host.supervisor -> host.b.executor: send test step
host.a.executor -> host.a.tools: run
host.b.executor -> host.b.tools: run
host.a.tools -> phone_a: control device
host.b.tools -> phone_b: control device
