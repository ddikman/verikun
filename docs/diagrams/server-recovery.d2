...@_style

direction: down

loss: "Test failed:\nadb/idb stopped responding" {shape: oval}
end: Remove device lease
check: Check device response
alive: Device answers? {shape: diamond}
recover: Resume device commands
kill: "Kill device subprocess\nand stuck commands" {
  style.stroke: "#c8401f"
  style.font-color: "#c8401f"
}
cleanup: Wait for cleanup
warm: "Restore settings\nand prepare latest app"
ready: Device available again {shape: oval}
rerun: "Fresh test on\nanother device" {shape: oval}

loss -> end: test stops
end -> check: check device
end -> rerun: start again
check -> alive: response
alive -> recover: yes
recover -> warm: responding again
alive -> kill: no
kill -> cleanup: after it stops
cleanup -> warm: device responds again
warm -> ready: ready
